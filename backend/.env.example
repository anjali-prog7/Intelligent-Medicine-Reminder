# ============================================================
# PillSync backend environment template
# Copy this file to backend/.env and fill in your real values.
#   cp .env.example .env
# NEVER commit backend/.env — it is ignored by git.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL database
# ------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ------------------------------------------------------------
# Email (Django SMTP)
# Gmail example:  EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587
# For Gmail you MUST use an App Password (16 chars, no spaces):
#   https://myaccount.google.com/apppasswords
# EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are the SMTP credentials;
# DEFAULT_FROM_EMAIL is derived from EMAIL_HOST_USER automatically.
# Recipients are always reminder.user.email from the database.
# ------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------------------------
# Twilio (SMS + WhatsApp)
# From https://console.twilio.com/ -> Account Info -> API credentials
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender: Twilio phone number in E.164 form, e.g. +1xxxxxxxxxx
TWILIO_FROM=
# WhatsApp sender: Twilio WhatsApp-enabled number, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# ------------------------------------------------------------
# Optional: Celery / Redis (reminders also fire synchronously,
# so Celery is not required for email/SMS/WhatsApp to work)
# ------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
